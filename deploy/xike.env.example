# Copy outside the repository to /etc/xike/xike.env and restrict permissions.
SERVER_ADDRESS=127.0.0.1
DB_URL='jdbc:h2:file:/var/lib/xike/aihealth-data;AUTO_SERVER=TRUE'
DB_USERNAME=sa
AI_PROVIDER=mock
AI_DAILY_CALL_LIMIT=100
AUTH_EMAIL_MODE=local

# If TokenHub is enabled later, set only in the private server environment:
# AI_PROVIDER=compatible
# AI_CHAT_URL=https://tokenhub.tencentmaas.com/v1/chat/completions
# AI_MODEL=hy3
# AI_API_KEY=<private value, never in this file or the upload ZIP>
