# Example values only. Set these in the process environment; this file is not loaded automatically.
DB_URL=jdbc:h2:file:./aihealth-data;AUTO_SERVER=TRUE
DB_USERNAME=sa
DB_PASSWORD=
SERVER_ADDRESS=127.0.0.1
H2_CONSOLE_ENABLED=false
# Optional experimental chat-completions provider. Mock is the default.
AI_PROVIDER=mock
AI_CHAT_URL=
AI_MODEL=
# Never commit a real key.
AI_API_KEY=
# Tencent Cloud TokenHub (Guangzhou) example; set these in backend process environment only:
# AI_PROVIDER=compatible
# AI_CHAT_URL=https://tokenhub.tencentmaas.com/v1/chat/completions
# AI_MODEL=hy3
# AI_API_KEY=<set locally, never in this file>

# Email verification defaults to local demo. Optional SMTP requires a private test mailbox.
AUTH_EMAIL_MODE=local
# AUTH_EMAIL_MODE=smtp
# SPRING_MAIL_HOST=smtp.example.test
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=<set locally>
# SPRING_MAIL_PASSWORD=<set locally, never in this file>
# AUTH_MAIL_FROM=no-reply@example.test
